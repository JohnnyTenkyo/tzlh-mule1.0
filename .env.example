# ============================================================
# Core Configuration
# ============================================================
PORT=3000
JWT_SECRET=your-random-secret-at-least-32-characters-long

# Database (Neon PostgreSQL free tier - https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# App ID (for JWT - set to any value for self-hosted)
VITE_APP_ID=tzlh-quant-self-hosted

# ============================================================
# Market Data API Keys (All Free Tier)
# ============================================================
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPHAVANTAGE_API_KEY=your-alphavantage-key
TIINGO_API_KEY=your-tiingo-key
FINNHUB_API_KEY=your-finnhub-key
POLYGON_API_KEY=your-polygon-key
TWELVE_DATA_API_KEY=your-twelve-data-key
MARKETSTACK_API_KEY=your-marketstack-key

# ============================================================
# AI Configuration (Optional - OpenAI-compatible proxy)
# ============================================================
OPENAI_API_KEY=your-openai-compatible-key
OPENAI_BASE_URL=https://openfly.cc/v1
OPENAI_MODEL=gpt-5.1-codex
